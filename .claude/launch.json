{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "eraya-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "eraya-prod",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3001"],
      "port": 3001
    },
    {
      "name": "eraya-lan",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "-p", "3002", "-H", "0.0.0.0"],
      "port": 3002,
      "autoPort": false
    }
  ]
}
